# ==========================================
# Wix Headless Configuration
# ==========================================

# Frontend Wix OAuth Client ID (Public / Safe for browser via VITE_)
VITE_WIX_CLIENT_ID=your_client_id
WIX_CLIENT_ID=your_client_id

# Server-Side Only: Wix Admin API Key (SECRET - Never prefix with VITE_)
WIX_API_KEY=your_admin_api_key
